# Copy this file to `.env` (this exact path: backend/.env) before running
# `docker compose up -d --build` from the repo root. docker-compose.yml reads
# it directly (env_file) for both the backend/scheduler containers (Laravel
# vars below) and the db container (MYSQL_* vars at the bottom) — one file,
# one source of truth.
#
# Generate a real APP_KEY (don't ship the one below, it's a placeholder):
#   docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Generate strong DB passwords the same way you would for any prod secret.

APP_NAME="Hotel Reservation API"
APP_ENV=production
APP_KEY=CHANGE_ME_GENERATE_A_NEW_KEY
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://5.75.128.196:4008

FRONTEND_URL=http://5.75.128.196:4008

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# "db" is the docker-compose service name, not localhost — the backend and
# db containers are on their own network, not the host's.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hotel_reservation
DB_USERNAME=hotel_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No ShouldQueue jobs exist in this codebase (see routes/console.php for the
# only two scheduled commands) — sync means nothing is silently dropped by a
# queue worker that was never deployed.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- mysql:8.0 container (the "db" service) reads these directly ---
# Must stay identical to DB_DATABASE/DB_USERNAME/DB_PASSWORD above — same
# database, same user, just read by two different processes.
MYSQL_DATABASE=hotel_reservation
MYSQL_USER=hotel_app
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
