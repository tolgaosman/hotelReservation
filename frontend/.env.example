# Internal URL the Next.js server uses to reach the Laravel backend (SSR calls
# and the /api/* rewrite proxy in next.config.ts). The browser never calls this
# directly — it only ever talks to this Next.js server.
# Defaults to http://127.0.0.1:8000 if unset (matches `php artisan serve` locally).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
